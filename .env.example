# Base de datos PostgreSQL (Supabase)
# DATABASE_URL usa pgbouncer (transaction pooling), DIRECT_URL es el directo para migraciones
DATABASE_URL="postgresql://postgres:password@db.x.supabase.co:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:password@db.x.supabase.co:5432/postgres?sslmode=require"

# NextAuth
AUTH_SECRET="genera-uno-con: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Primer usuario ADMIN (obligatorio para db:seed; el seed no crea datos de ejemplo)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD="genera-una-clave-segura-de-al-menos-8-caracteres"
